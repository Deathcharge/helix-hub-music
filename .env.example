# Optional default workspace folder for `samsarix-workspace serve`.
SAMSARIX_WORKSPACE_ROOT=../my-workspace

# Required for non-loopback binding. Generate a long random value; never commit it.
SAMSARIX_WORKSPACE_TOKEN=replace-with-a-long-random-secret

# Accepted Host values for environment-created app instances (comma-separated).
# The CLI uses repeatable --allowed-host options instead.
SAMSARIX_WORKSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
